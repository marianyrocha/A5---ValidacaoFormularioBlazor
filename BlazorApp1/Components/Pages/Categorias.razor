@page "/categorias"
@using BlazorApp1.Components.Models

<h3>Categorias</h3>

<div class="row">
    <div class="col-md-4">
        <div class="card card-body">
            <EditForm Model="categoria" OnValidSubmit="AdicionarCategoria">
                <DataAnnotationsValidator />

                <label class="form0label">Nome</label>
                <InputText class="form-control" @bind-Value="categoria.Nome" placeholder="Nome"/>
                <ValidationMessage For="() => categoria.Nome" />  
                
                <label class="form0label">Quantidade</label>
                <InputNumber class="form-control" type="number" @bind-Value="categoria.Quantidade" placeholder="Quantidade"/>
                <ValidationMessage For="() => categoria.Quantidade" />  
                
                <button class="btn btn-primary" type="submit">Adicionar</button>
            </EditForm>
        </div>
        
    </div>

    <div class="col-md-4">
        <table class="table">
            <thead>
            <tr>
                <th>Nome</th>
                <th>Quantidade</th>
            </tr>
            </thead>
            <tbody>
            @if(categorias.Count==0)
            {
                <p class="text-muted">Nenuma categoria</p>
                        
            }
            else
            {
                @foreach (var c in categorias)
                {
                    <tr>
                        <td>@c.Nome</td>
                        <td>@c.Quantidade</td>
                    </tr>
                }
            }
            </tbody>

        </table>
    </div>
</div>

@code{

    private Categoria categoria = new();

    private List<Categoria> categorias = new();

    private void AdicionarCategoria()
    {
        categorias.Add(new Categoria
        {
            Nome = categoria.Nome,
            Quantidade = categoria.Quantidade
        });

        categoria = new Categoria();

    }

}