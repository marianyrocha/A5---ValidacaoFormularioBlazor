@page "/produtos"
@using BlazorApp1.Components.Models

<h3>Produtos</h3>
<div class="row">
    <div class="col-md-4">
        <div class="card card-body">
            <label class="form0label">Nome</label>
            <input class="form-control" @bind="nome" placeholder="Nome"/>
            
            <label class="form0label">Quantidade</label>
            <input class="form-control" type="number" @bind="quantidade" placeholder="Quantidade"/>
            
            <label class="form0label">Preço</label>
            <input class="form-control" type="number" step="0.01" @bind="preco" placeholder="Preço"/>
            
            <button class="btn btn-primary" @onclick="AdicionarProduto">Adicionar Produto</button>
        </div>
    </div>
    
    <div class="col-md-8">
        <table class="table">
            <thead>
            <tr>
                <th>Nome</th>
                <th>Quantidade</th>
                <th>Preço</th>
            </tr>
            </thead>
            <tbody>
                @if(produtos.Count==0)
                {
                    <p class="text-muted">Nenum produto</p>
                    
                }
                else
                {
                    @foreach (var p in produtos)
                    {
                        <tr>
                            <td>@p.Nome</td>
                            <td>@p.Preco.</td>
                            <td>@p.Quantidade</td>
                        </tr>
                    }
                }

            
            </tbody>

        </table>
    </div>
</div>
@code {
    private string nome = "";
    private int quantidade;
    private decimal preco;

    private List<Produto> produtos = new();

    private void AdicionarProduto()
    {
        produtos.Add(new Produto 
        {
            Nome = nome,
            Preco = preco,
            Quantidade = quantidade
        });

        nome = "";
        preco = 0;
        quantidade = 1;
    }
}