@page "/produtos"
@using BlazorApp1.Components.Models

<h3>Produtos</h3>
<div class="row">
    <div class="col-md-4">
        
        <div class="card card-body">
            <EditForm Model="produto" OnValidSubmit="AdicionarProduto">
                <DataAnnotationsValidator />
                
                <label class="form0label">Nome</label>
                <InputText class="form-control" @bind-Value="produto.Nome" placeholder="Nome"/>
                <ValidationMessage For="() => produto.Nome" />
                <br>
                <label class="form0label">Quantidade</label>
                <InputNumber class="form-control" type="number" @bind-Value="produto.Quantidade" placeholder="Quantidade"/>
                <br>
                <label class="form0label">Preço</label>
                <InputNumber class="form-control" type="number" step="0.01" @bind-Value="produto.Preco" placeholder="Preço"/>
                <ValidationMessage For="() => produto.Preco" />
                <br>
                <button class="btn btn-primary" type="submit" >Adicionar Produto</button>
                
            </EditForm>   
        </div>
    </div>
    
    <div class="col-md-8">
        <table class="table">
            <thead>
            <tr>
                <th>Nome</th>
                <th>Quantidade</th>
                <th>Preço</th>
            </tr>
            </thead>
            <tbody>
                @if(produtos.Count==0)
                {
                    <p class="text-muted">Nenum produto</p>
                    
                }
                else
                {
                    @foreach (var p in produtos)
                    {
                        <tr>
                            <td>@p.Nome</td>
                            <td>@p.Preco.</td>
                            <td>@p.Quantidade</td>
                        </tr>
                    }
                }

            
            </tbody>

        </table>
    </div>
</div>
@code {
    private Produto produto = new();
    
    private List<Produto> produtos = new();

    private void AdicionarProduto()
    {
        produtos.Add(new Produto
        {
            Nome = produto.Nome,
            Preco = produto.Preco,
            Quantidade = produto.Quantidade
        });

        produto = new Produto();
    }
}